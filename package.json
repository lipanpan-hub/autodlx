{
  "name": "@lppx/autodlx",
  "description": "A developer-friendly multi-command CLI tool",
  "version": "0.0.0",
  "author": "lppx",
  "bin": {
    "adl": "./bin/run.js"
  },
  "bugs": "https://github.com/lipanpan-hub/autodlx/issues",
  "dependencies": {
    "@earendil-works/pi-tui": "^1.2.0",
    "@inquirer/prompts": "^8.7.3",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^4.0.4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^4.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "@oclif/plugin-warn-if-update-available": "^4.0.3",
    "fuse.js": "^7.5.0",
    "pino": "^10.4.0",
    "pino-mongodb": "^5.0.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/prompts": "^2.4.9",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lipanpan-hub/autodlx",
  "keywords": [
    "oclif"
  ],
  "license": "BSL",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "adl",
    "dirname": "autodlx",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "nsisCustomization": "nsis/nsis.nsi",
    "hooks": {
      "init": "./dist/hooks/init/inithook"
    },
    "topicSeparator": " ",
    "topics": {
      "instance": {
        "description": "AutoDL 容器实例管理 (创建/开关机/释放等)"
      },
      "image": {
        "description": "AutoDL 私有镜像管理 (查看私有镜像列表等)"
      },
      "art": {
        "description": "AutoDL.art ComfyUI API (提交工作流任务/查询进度/下载产物)"
      },
      "config": {
        "description": "CLI 配置档案管理 (查看/切换/编辑配置文件)"
      }
    }
  },
  "repository": "lipanpan-hub/autodlx",
  "scripts": {
    "build": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "lint": "eslint",
    "start": "node ./bin/run.js",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
